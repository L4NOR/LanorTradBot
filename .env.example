# LanorTradBot - variables d'environnement
# Copie ce fichier en .env et remplis-le. NE COMMIT JAMAIS .env

# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Serveur par defaut : prod ou test (sinon la question est posee au lancement)
LANOR_SERVER=prod

# Site source de verite (optionnel, valeur par defaut ci-dessous)
SITE_URL=https://lanortradtest.netlify.app
